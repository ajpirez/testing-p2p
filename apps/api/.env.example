PORT=4000

# Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/p2p?schema=public

# Redis (opcional por ahora; preparado para locks/jobs)
REDIS_URL=redis://127.0.0.1:6379

# MinIO (para evidencias/archivos; opcional por ahora)
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=p2p

MINIO_ENDPOINT=localhost
MINIO_PORT=5090
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioAdminPass
MINIO_BUCKET_NAME=token
MINIO_USE_SSL=false


# Ganache / red por defecto (chainId 1337)
GANACHE_RPC_URL=http://127.0.0.1:7545
P2P_ESCROW_CONTRACT_ADDRESS=
# P2P_DEFAULT_CHAIN_NAME=  # opcional: etiqueta para GET /chains (ej. "Local")

# Redes adicionales (opcional): JSON por chainId con rpc, escrow, y opcionalmente escrow USDT/USDC.
# signerPk: clave privada hex para firmar en esa red (si no hay cuentas desbloqueadas).
# name: etiqueta opcional para GET /chains.
# escrowUsdt, tokenUsdt: contrato P2PEscrowERC20 y dirección del token USDT para ofertas en USDT.
# escrowUsdc, tokenUsdc: idem para USDC.
# P2P_CHAINS={"97":{"rpc":"https://…","escrow":"0x…","signerPk":"0x…","name":"…","escrowUsdt":"0x…","tokenUsdt":"0x…","escrowUsdc":"0x…","tokenUsdc":"0x…"}}

