GANACHE_RPC_URL=http://127.0.0.1:7545
# Chain ID: debe coincidir con lo que devuelve tu Ganache.
# Si el deploy falla con "connected to a chain with id 1337", descomenta la línea de abajo.
# GANACHE_CHAIN_ID=1337
#
# Opción A (recomendado): usa el mnemonic que te da Ganache
GANACHE_MNEMONIC="true orient erupt advice behave plunge rural merit sword oval project word"
#
# Opción B: forzar un deployer específico (priv key hex con 0x)
# DEPLOYER_PRIVATE_KEY=0x...
#
# Para fund-test-tokens:ganache (copiar de P2P_CHAINS en apps/api/.env)
# TOKEN_USDT=0x...
# TOKEN_USDC=0x...

